%%在这里可更改封面logo
\newcommand{\cover}{
%%封面校名logo，图片都在figures文件夹里
\newgeometry{top=1.5cm, includehead, headheight=0.5cm, headsep=3.15cm}
\fancyhfoffset[E,O]{0pt}
\begin{center}

    % ----- 插入图片 -----
    \includegraphics[height=2.1cm]{\coverimage}\\[2.55cm]
    
    % ----- 标题 -----
    {\zihao{2}\song\bfseries 标题：\assignmenttitle}\vspace{1.2cm}
    
    {
    \setlength{\baselineskip}{1.1cm}
    \selectfont
    % ----- 作者及联系方式 -----
        {\zihao{3}\kai\bfseries 作者：\authorname（\authorid+\authorphone）}\\
    
    % ----- 学院 -----
        {\zihao{3}\kai\bfseries 所在学院：\college}\\
    
    % ----- 指导教师 -----
        {\zihao{3}\kai\bfseries 指导教师：\supervisor}\\[4.4cm]
        
        {\zihao{3}\song  \coverdate}
    \par
    }
\end{center}
\restoregeometry
\fancyhfoffset[E,O]{0pt}
}

\newenvironment{cnabstract}[1]{%
    \def\cnkeyword{#1}%
    \par{\zihao{-4}\song\bfseries [摘要]\;\;}%
    \ignorespaces
}{%
    \par{\song\zihao{-4}\bfseries [关键词]\;\;}\cnkeyword
}