\usepackage{xeCJK}

\setCJKmainfont[AutoFakeBold = 2.0]{simsun.ttc}
\setCJKsansfont[AutoFakeBold = 2.0]{simsun.ttc}
\setCJKmonofont[AutoFakeBold = 2.0]{simsun.ttc}
\setmainfont[AutoFakeBold = 2.0]{simsun.ttc}

\setCJKfamilyfont{song}[AutoFakeBold = 2.0]{simsun.ttc}
\setCJKfamilyfont{hei}{simhei.ttf}
\setCJKfamilyfont{kai}[AutoFakeBold = 2.0]{simkai.ttf}
\setCJKfamilyfont{hwxk}[AutoFakeBold = 1.6]{华文行楷.ttf}
\newcommand{\song}{\CJKfamily{song}}    % 宋体   (Windows自带simsun.ttf)
\newcommand{\hei}{\CJKfamily{hei}}      % 黑体   (Windows自带simhei.ttf)
\newcommand{\kai}{\CJKfamily{kai}}      % 黑体   (Windows自带simkai.ttf)
\newcommand{\hwxk}{\CJKfamily{hwxk}}      % 华文行楷

\ctexset{
    % 修改 section。
    section={   
        name={,、},
        number={\chinese{section}},
        format=\centering\song\bfseries\zihao{4},
        aftername = \hspace{0pt}
    },
    % 修改 subsection。
    subsection={   
        name={（,）},
        number={\arabic{subsection}},
        format=\song\bfseries\zihao{4},
        indent = 2\ccwd,
        aftername = \hspace{0pt}
    }
}

%%文本框设置
\newcommand{\tbox}[1]{
\begin{center}
\begin{tcolorbox}[colback=gray!10,%gray background
                  colframe=black,% black frame colour
                  width=8cm,% Use 8cm total width,
                  arc=1mm, auto outer arc,
                  boxrule=0.5pt,
                 ]
{#1}
\end{tcolorbox}
\end{center}
}

